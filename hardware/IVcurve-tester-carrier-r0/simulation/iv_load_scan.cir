RN2 dut2 0 {RSRC + (1-SOURCE_MODE)*1e12}
RLOAD2 dut2 mux2 {RCH2}
VMEAS2 mux2 ron2 0
RRON2 ron2 0 {RON}
RADC_SER2 dut2 adc2 {ADC_RSER}
RADC_IN2 adc2 0 {ADC_RIN}
CADC2 adc2 0 {ADC_CIN}
DADC_HI2 adc2 vdd DCLAMP
DADC_LO2 0 adc2 DCLAMP

